<svg width="500" height="128" viewBox="0 0 500 128" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <clipPath id="cardClip">
            <rect width="500" height="128" rx="10" ry="10" />
        </clipPath>
        <filter id="coverBlur" x="-20%" y="-60%" width="140%" height="220%">
            <feGaussianBlur stdDeviation="24" />
            <feColorMatrix type="saturate" values="1.35" />
        </filter>
    </defs>
    <g clip-path="url(#cardClip)">
        <image href="data:image/png;base64, {{image}}" x="-20" y="-186" width="540" height="540" preserveAspectRatio="xMidYMid slice" filter="url(#coverBlur)" opacity="0.46" />
        <rect width="500" height="128" fill="#{{background_color}}" opacity="0.72" />
        <circle cx="92" cy="52" r="150" fill="rgb({{ barPalette[0][0] }}, {{ barPalette[0][1] }}, {{ barPalette[0][2] }})" opacity="0.22" />
        <circle cx="368" cy="18" r="170" fill="rgb({{ barPalette[1][0] }}, {{ barPalette[1][1] }}, {{ barPalette[1][2] }})" opacity="0.16" />
        <circle cx="452" cy="126" r="150" fill="rgb({{ barPalette[2][0] }}, {{ barPalette[2][1] }}, {{ barPalette[2][2] }})" opacity="0.14" />
    </g>
    <rect x="0.5" y="0.5" width="499" height="127" rx="9.5" ry="9.5" fill="none" stroke="#{{border_color}}" />
    <foreignObject width="500" height="128">
        <div xmlns="http://www.w3.org/1999/xhtml" class="card">
            <style>
                * {
                    box-sizing: border-box;
                }

                .card {
                    position: relative;
                    width: 500px;
                    height: 128px;
                    overflow: hidden;
                    border-radius: 10px;
                    background: linear-gradient(90deg, rgba(248, 250, 252, 0.20) 0%, rgba(255, 255, 255, 0.78) 42%, rgba(255, 255, 255, 0.90) 100%);
                    color: #111827;
                    font-family: "Segoe UI", Helvetica, Arial, sans-serif;
                    padding: 16px;
                }

                .shell {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    height: 96px;
                }

                .cover {
                    width: 96px;
                    height: 96px;
                    display: block;
                    border: 1px solid rgba(15, 23, 42, 0.12);
                    border-radius: 9px;
                    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.16);
                    object-fit: cover;
                }

                .content {
                    min-width: 0;
                    flex: 1;
                }

                .topline {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 12px;
                    margin-bottom: 10px;
                }

                .status {
                    display: flex;
                    align-items: center;
                    gap: 7px;
                    color: #64748b;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.06em;
                    line-height: 1;
                    text-transform: uppercase;
                }

                .dot {
                    width: 7px;
                    height: 7px;
                    border-radius: 999px;
                    background: rgb({{ songPalette[0][0] }}, {{ songPalette[0][1] }}, {{ songPalette[0][2] }});
                }

                .spotify {
                    flex: 0 0 auto;
                    width: 19px;
                    height: 19px;
                    color: rgb({{ songPalette[0][0] }}, {{ songPalette[0][1] }}, {{ songPalette[0][2] }});
                }

                .song,
                .artist {
                    display: block;
                    max-width: 350px;
                    overflow: hidden;
                    text-decoration: none;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

                .song {
                    color: #0f172a;
                    font-size: 23px;
                    font-weight: 750;
                    line-height: 1.1;
                    margin-bottom: 6px;
                }

                .artist {
                    color: #475569;
                    font-size: 15px;
                    font-weight: 600;
                    line-height: 1.2;
                }

                #bars {
                    position: relative;
                    width: {{barWidth}}px;
                    height: {{barHeight}}px;
                    margin-top: 7px;
                    overflow: hidden;
                    opacity: 0.96;
                }

                .bar {
                    position: absolute;
                    bottom: 0;
                    width: 3px;
                    height: 15px;
                    border-radius: 999px;
                    background: linear-gradient(
                        90deg,
                        rgb({{ barPalette[0][0] }}, {{ barPalette[0][1] }}, {{ barPalette[0][2] }}) 0%,
                        rgb({{ barPalette[1][0] }}, {{ barPalette[1][1] }}, {{ barPalette[1][2] }}) 33%,
                        rgb({{ barPalette[2][0] }}, {{ barPalette[2][1] }}, {{ barPalette[2][2] }}) 66%,
                        rgb({{ barPalette[3][0] }}, {{ barPalette[3][1] }}, {{ barPalette[3][2] }}) 100%
                    );
                    background-size: 200% 100%;
                    background-position: 0% 50%;
                    box-shadow: 0 0 8px rgba({{ barPalette[0][0] }}, {{ barPalette[0][1] }}, {{ barPalette[0][2] }}, 0.22);
                    animation: gradient 15s ease infinite, pulse 0ms -800ms ease-in infinite alternate;
                }

                .bar:nth-child(4n + 1) {
                    background: linear-gradient(180deg, rgb({{ barPalette[0][0] }}, {{ barPalette[0][1] }}, {{ barPalette[0][2] }}), rgb({{ barPalette[1][0] }}, {{ barPalette[1][1] }}, {{ barPalette[1][2] }}));
                }

                .bar:nth-child(4n + 2) {
                    background: linear-gradient(180deg, rgb({{ barPalette[1][0] }}, {{ barPalette[1][1] }}, {{ barPalette[1][2] }}), rgb({{ barPalette[2][0] }}, {{ barPalette[2][1] }}, {{ barPalette[2][2] }}));
                }

                .bar:nth-child(4n + 3) {
                    background: linear-gradient(180deg, rgb({{ barPalette[2][0] }}, {{ barPalette[2][1] }}, {{ barPalette[2][2] }}), rgb({{ barPalette[3][0] }}, {{ barPalette[3][1] }}, {{ barPalette[3][2] }}));
                }

                .bar:nth-child(4n) {
                    background: linear-gradient(180deg, rgb({{ barPalette[3][0] }}, {{ barPalette[3][1] }}, {{ barPalette[3][2] }}), rgb({{ barPalette[0][0] }}, {{ barPalette[0][1] }}, {{ barPalette[0][2] }}));
                }

                @keyframes gradient {
                    0% {
                        background-position: 0% 50%;
                    }

                    50% {
                        background-position: 100% 50%;
                    }

                    100% {
                        background-position: 0% 50%;
                    }
                }

                @keyframes pulse {
                    0% {
                        height: 3px;
                        opacity: 0.35;
                    }

                    100% {
                        height: {{barHeight}}px;
                        opacity: 1;
                    }
                }

                {{barCSS|safe}}
            </style>

            <div class="shell">
                <a href="{{songURI}}" target="_blank">
                    <img src="data:image/png;base64, {{image}}" class="cover" />
                </a>

                <div class="content">
                    <div class="topline">
                        <div class="status"><span class="dot"></span>{{status}}</div>
                        <a href="{{songURI}}" target="_blank" class="spotify">
                            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <title>Spotify</title>
                                <path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z" />
                            </svg>
                        </a>
                    </div>
                    <a href="{{songURI}}" target="_blank" class="song">{{songName}}</a>
                    <a href="{{artistURI}}" target="_blank" class="artist">{{artistName}}</a>
                    <div id="bars">{{contentBar|safe}}</div>
                </div>
            </div>
        </div>
    </foreignObject>
</svg>
